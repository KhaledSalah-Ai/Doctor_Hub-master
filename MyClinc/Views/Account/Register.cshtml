@model MyClinc.ViewModels.ApplicationUserVM

@{
    ViewData["Title"] = "إنشاء حساب جديد";
}

<section class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow rounded-4 border-0">
                <div class="card-body p-4">
                    <h3 class="text-center mb-4 text-primary"><i class="fas fa-user-plus me-2"></i>إنشاء حساب جديد</h3>

                    <form asp-action="Register" method="post">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FirstName" class="form-label">الاسم الأول</label>
                                <input asp-for="FirstName" class="form-control" placeholder="أدخل الاسم الأول" />
                                <span asp-validation-for="FirstName" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="LastName" class="form-label">اسم العائلة</label>
                                <input asp-for="LastName" class="form-control" placeholder="أدخل اسم العائلة" />
                                <span asp-validation-for="LastName" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">البريد الإلكتروني</label>
                            <input asp-for="Email" class="form-control" placeholder="example@email.com" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PhoneNumber" class="form-label">رقم الهاتف</label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="مثال: 010xxxxxxxx" />
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label for="password" class="form-label">كلمة المرور</label>
                            <input name="password" type="password" class="form-control" placeholder="********" />
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-user-plus me-1"></i> إنشاء الحساب
                            </button>
                        </div>
                    </form>

                    <div class="text-center mt-3">
                        <p>هل لديك حساب؟ <a asp-controller="Account" asp-action="Login" class="text-decoration-underline">تسجيل الدخول</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<style>
    .card {
        display: block !important;
        opacity: 1 !important;
        visibility: visible !important;
    }
</style>