@model List<DAL.Data.Models.Course>

@{
    ViewData["Title"] = "كورساتي";
}

<div class="container my-5">
    <h2 class="mb-5 text-center fw-bold" style="color: #2B3A55;">كورساتك المشتراة</h2>

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var course in Model)
            {
                <div class="col-md-4">
                    <div class="card h-100 shadow border-0 rounded-4 overflow-hidden">
                        <img src="~/images/@course.ImageUrl" class="card-img-top" style="height: 200px; object-fit: cover;" alt="@course.Title" />

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-bold text-primary">@course.Title</h5>

                            <p class="card-text text-muted mb-2">
                                <i class="fas fa-align-left me-1 text-secondary"></i>
                                @course.ShortDescription
                            </p>

                            <div class="mb-2">
                                <small class="text-secondary">
                                    <i class="fas fa-users me-1"></i>
                                    الفئة المستهدفة: @course.TargetAudience
                                </small>
                            </div>

                            <div class="mb-3">
                                <small class="text-success fw-semibold">
                                    <i class="fas fa-dollar-sign me-1"></i>
                                    السعر: @course.Price جنيه
                                </small>
                            </div>

                            <a href="@Url.Action("MyDetails", "Courses", new { id = course.Id })" class="btn btn-outline-primary mt-auto w-100">
                                <i class="fas fa-play-circle me-1"></i> ابدأ الكورس
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info text-center mt-5">
            <i class="fas fa-info-circle me-2"></i> لم تقم بشراء أي كورسات بعد.
        </div>
    }
</div>
<style>
    .card {
        display: block !important;
        opacity: 1 !important;
        visibility: visible !important;
    }
</style>