@model DAL.Data.Models.Course
@{
    ViewData["Title"] = "تفاصيل كورساتي";

    string videoUrl = Model.Videos?.GoogleDriveLink;
    string videoId = "";
    string embedUrl = "";

    if (!string.IsNullOrEmpty(videoUrl))
    {
        var parts = videoUrl.Split("/");
        if (parts.Length >= 6)
        {
            videoId = parts[5];
            embedUrl = $"https://drive.google.com/file/d/{videoId}/preview";
        }
    }
}

<section class="container mt-5 mb-4">
    <div class="card shadow-sm rounded-4 p-4">
        <h4 class="text-primary mb-4">
            <i class="fas fa-info-circle me-2"></i>تفاصيل الكورس
        </h4>

        <div class="mb-3">
            <h5 class="fw-bold text-secondary">عنوان الكورس:</h5>
            <p class="fs-5">@Model.Title</p>
        </div>

        <div class="mb-3">
            <h5 class="fw-bold text-secondary">الوصف المختصر:</h5>
            <p>@Model.ShortDescription</p>
        </div>

        <div class="mb-3">
            <h5 class="fw-bold text-secondary">الفوائد:</h5>
            <p>@Model.Benefits</p>
        </div>

        <div class="mb-3">
            <h5 class="fw-bold text-secondary">السعر:</h5>
            <p class="text-success fw-bold">@Model.Price.ToString("C", new System.Globalization.CultureInfo("ar-EG"))</p>
        </div>

        @if (Model.Chapters != null && Model.Chapters.Any())
        {
            <div class="mb-3">
                <h5 class="fw-bold text-secondary">فصول الكورس:</h5>
                <ul class="list-group list-group-flush">
                    @foreach (var item in Model.Chapters)
                    {
                        <li class="list-group-item">@item.Title</li>
                    }
                </ul>
            </div>
        }

        <div class="mb-3">
            <h5 class="fw-bold text-secondary">الجمهور المستهدف:</h5>
            <p>@Model.TargetAudience</p>
        </div>

        @if (!string.IsNullOrEmpty(embedUrl))
        {
            <div class="mb-4">
                <h5 class="fw-bold text-secondary">الفيديو:</h5>
                <div class="ratio ratio-16x9">
                    <iframe src="@embedUrl"
                            width="640" height="480"
                            allow="autoplay" allowfullscreen
                            class="rounded-3 shadow">
                    </iframe>
                </div>
            </div>
        }

        <div class="mt-4">
            <a class="btn btn-secondary rounded-pill" href="/Courses/MyCourses">
                <i class="fas fa-arrow-right me-1"></i>العودة للكورسات
            </a>
        </div>
    </div>
</section>

<style>
    .card {
        display: block !important;
        opacity: 1 !important;
        visibility: visible !important;
    }
</style>

