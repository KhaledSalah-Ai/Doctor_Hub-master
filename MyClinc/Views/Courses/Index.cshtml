@model List<DAL.Data.Models.Course>
@{
    ViewData["Title"] = "الكورسات التدريبية";
}

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
@if (TempData["Message"] != null)
{
    <script type="text/javascript">
        $(document).ready(function () {
            toastr.warning("@TempData["Message"]");
        });
    </script>
}

<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center min-vh-75">
            <div class="col-lg-6 hero-content">
                <h1 class="hero-title fade-in">
                    الكورسات التدريبية
                    <span style="color: var(--text-medium);">الطبية المتخصصة</span>
                </h1>
                <p class="hero-subtitle fade-in">
                    برامج تدريبية متخصصة لتطوير المهارات الطبية والمهنية.
                    نقدم كورسات عالية الجودة مع أفضل المدربين المتخصصين في المجال الطبي.
                </p>
                <div class="hero-buttons fade-in">
                    <a href="#courses-section" class="btn-primary-custom">
                        <i class="fas fa-graduation-cap me-2"></i>تصفح الكورسات
                    </a>
                    <a asp-controller="About" asp-action="Index" class="btn-secondary-custom">
                        <i class="fas fa-info-circle me-2"></i>تعرف على فريقنا
                    </a>
                </div>
            </div>
            <div class="col-lg-6 text-center slide-in-right">
                <div class="hero-image">
                    <img src="~/images/medical_assets/pexels-cosmetica-academy-2149795492-31613326.jpg" alt="كورسات تدريبية طبية"
                         class="img-fluid rounded-3 shadow-lg"
                         style="max-height: 500px; object-fit: cover; border-radius: 20px !important;">
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Courses Section -->
<section class="services-section" id="courses-section">
    <div class="container">
        <div class="row text-center mb-5">
            <div class="col-lg-8 mx-auto">
                <h2 class="section-title">كورساتنا التدريبية</h2>
                <p class="section-subtitle">نقدم مجموعة متنوعة من الكورسات التدريبية المتخصصة في المجال الطبي</p>
            </div>
        </div>

        <div class="row g-4">
            @foreach (var course in Model)
            {
                if (course.IsActive)
                {
                    <div class="col-lg-6 col-md-6">
                        <div class="service-card shadow-sm h-100 rounded-4 fade-in">
                            <div class="course-image-container mb-3">
                                <img src="~/images/@course.ImageUrl" alt="@course.Title"
                                     style="width: 100%; height: 250px; object-fit: cover; border-radius: 15px;">
                            </div>
                            <div class="service-content">
                                <h5 class="service-title">@course.Title</h5>
                                <p class="service-description">@course.ShortDescription</p>
                                <div class="course-details my-3">
                                    <small style="color: var(--text-medium);">
                                        <i class="fas fa-user-graduate me-1"></i>
                                        الجمهور المستهدف: @course.TargetAudience
                                    </small>
                                </div>
                                <div class="course-actions">
                                    <a href="@Url.Action("Details", "Courses", new { id = course.Id })"
                                       class="btn-primary-custom w-100 py-2">
                                        <i class="fas fa-info-circle me-2"></i>عرض التفاصيل
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        <!-- Pagination -->
        @if (ViewBag.TotalPages > 1)
        {
            <nav class="mt-5">
                <ul class="pagination justify-content-center">
                    @if (ViewBag.CurrentPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link rounded-pill" href="@Url.Action("Index", new { page = ViewBag.CurrentPage - 1 })">السابق</a>
                        </li>
                    }

                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                            <a class="page-link rounded-pill" href="@Url.Action("Index", new { page = i })">@i</a>
                        </li>
                    }

                    @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                    {
                        <li class="page-item">
                            <a class="page-link rounded-pill" href="@Url.Action("Index", new { page = ViewBag.CurrentPage + 1 })">التالي</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
</section>

<!-- Features Section -->
<section class="about-section">
    <div class="container">
        <div class="row text-center mb-5">
            <div class="col-lg-8 mx-auto">
                <h2 class="section-title">مميزات كورساتنا التدريبية</h2>
                <p class="section-subtitle">نقدم تجربة تعليمية متميزة مع أفضل المدربين والمحتوى العلمي المتطور</p>
            </div>
        </div>

        <div class="row g-4">
            @{
                var features = new[]
                {
            new { Icon = "fas fa-certificate", Title = "شهادات معتمدة", Desc = "شهادات معتمدة من جهات طبية موثوقة" },
            new { Icon = "fas fa-user-md", Title = "مدربون خبراء", Desc = "أطباء ومختصون بخبرة تزيد عن 15 عاماً" },
            new { Icon = "fas fa-laptop", Title = "تعلم تفاعلي", Desc = "منصة تعليمية تفاعلية مع أحدث التقنيات" },
            new { Icon = "fas fa-headset", Title = "دعم مستمر", Desc = "دعم فني وأكاديمي على مدار الساعة" },
            };
            }

            @foreach (var feature in features)
            {
                <div class="col-lg-3 col-md-6">
                    <div class="service-card text-center fade-in">
                        <div class="service-icon mb-2">
                            <i class="@feature.Icon fa-2x text-primary"></i>
                        </div>
                        <h5 class="service-title">@feature.Title</h5>
                        <p class="service-description">@feature.Desc</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Call to Action Section -->
<section class="hero-section py-5" style="min-height: auto;">
    <div class="container">
        <div class="row text-center">
            <div class="col-lg-8 mx-auto hero-content">
                <h2 class="hero-title mb-3">هل تريد أن تكون أول من يعلم؟</h2>
                <p class="hero-subtitle mb-4">سجل اهتمامك الآن وكن أول من يحصل على إشعار عند إطلاق الكورسات التدريبية</p>
                <div class="hero-buttons">
                    <a href="https://wa.me/9647715513344" class="btn-secondary-custom">
                        <i class="fab fa-whatsapp me-1"></i> تواصل معنا لحجز الكورسات
                    </a>
                    <a asp-controller="Services" asp-action="Index" class="btn-secondary-custom">
                        <i class="fas fa-stethoscope me-2"></i>تعرف على خدماتنا
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        // Animation on scroll
        const observerOptions = {
            threshold: 0.1,
            rootMargin: "0px 0px -50px 0px"
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add("visible");
                    observer.unobserve(entry.target);
                }
            });
        }, observerOptions);

        document.addEventListener('DOMContentLoaded', function () {
            setTimeout(() => {
                document.querySelectorAll(".fade-in, .slide-in-left, .slide-in-right").forEach(el => {
                    observer.observe(el);
                });
            }, 100);
        });
    </script>
}
