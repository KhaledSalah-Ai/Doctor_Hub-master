    <script>
document.addEventListener("DOMContentLoaded", function () {
    const collapse = document.querySelector(".navbar-collapse");
    const toggler = document.querySelector(".navbar-toggler");
    const body = document.body;

    // التأكد من إن الـ sidebar مخفي في البداية
    if (window.innerWidth <= 991) {
        collapse.style.visibility = 'hidden';
        collapse.style.opacity = '0';
        collapse.style.transform = 'translateX(20px)';
    }

    // فتح وقفل الـ Sidebar
    toggler.addEventListener("click", function (e) {
        e.preventDefault();
        e.stopPropagation();
        
        if (window.innerWidth <= 991) {
            setTimeout(() => {
                body.classList.toggle("offcanvas-open");
                
                if (body.classList.contains("offcanvas-open")) {
                    collapse.style.visibility = 'visible';
                    collapse.style.opacity = '1';
                    collapse.style.transform = 'translateX(0)';
                    collapse.classList.add("show");
                    collapse.classList.add("showing");
                } else {
                    closeSidebar();
                }
            }, 10);
        }
    });

    // قفل لما يضغط على علامة × 
    collapse.addEventListener("click", function (e) {
        e.stopPropagation();
        const rect = collapse.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        
        // التحقق من الضغط على زر الإغلاق (في المنطقة العلوية اليسرى)
        if (x >= 0 && x <= 75 && y >= 0 && y <= 75) {
            closeSidebar();
        }
    });

    // قفل لما يضغط على الـ Overlay
    document.addEventListener("click", function (e) {
        if (body.classList.contains("offcanvas-open")) {
            if (!collapse.contains(e.target) && !toggler.contains(e.target)) {
                closeSidebar();
            }
        }
    });

    // قفل بالـ escape key
    document.addEventListener("keydown", function(e) {
        if (e.key === "Escape" && body.classList.contains("offcanvas-open")) {
            closeSidebar();
        }
    });

    // دالة إغلاق الـ sidebar محسنة
    function closeSidebar() {
        collapse.classList.remove("show");
        collapse.classList.remove("showing");
        body.classList.remove("offcanvas-open");
        
        if (window.innerWidth <= 991) {
            collapse.style.transform = 'translateX(20px)';
            
            setTimeout(() => {
                if (!body.classList.contains("offcanvas-open")) {
                    collapse.style.visibility = 'hidden';
                    collapse.style.opacity = '0';
                }
            }, 500);
        }
    }

    // حماية من الـ touch events على الـ mobile
    let touchStartX = null;
    let touchStartY = null;
    
    collapse.addEventListener('touchstart', function(e) {
        touchStartX = e.touches[0].clientX;
        touchStartY = e.touches[0].clientY;
    });

    collapse.addEventListener('touchmove', function(e) {
        if (touchStartX === null || touchStartY === null) return;
        
        let touchCurrentX = e.touches[0].clientX;
        let touchCurrentY = e.touches[0].clientY;
        let diffX = touchCurrentX - touchStartX;
        let diffY = Math.abs(touchCurrentY - touchStartY);
        
        // إذا السحب لليسار أكتر من 80px وكان أفقي أكتر من العمودي
        if (diffX < -80 && diffY < Math.abs(diffX)) {
            closeSidebar();
            touchStartX = null;
            touchStartY = null;
        }
    });

    collapse.addEventListener('touchend', function() {
        touchStartX = null;
        touchStartY = null;
    });

    // التعامل مع تغيير حجم الشاشة
    window.addEventListener('resize', function() {
        if (window.innerWidth > 991) {
            // Desktop mode
            body.classList.remove("offcanvas-open");
            collapse.classList.remove("show", "showing");
            collapse.style.visibility = '';
            collapse.style.opacity = '';
            collapse.style.transform = '';
        } else {
            // Mobile mode
            if (!body.classList.contains("offcanvas-open")) {
                collapse.style.visibility = 'hidden';
                collapse.style.opacity = '0';
                collapse.style.transform = 'translateX(20px)';
            }
        }
    });

    // تحسين الـ Bootstrap collapse integration
    const bsCollapse = new bootstrap.Collapse(collapse, {
        toggle: false
    });
    
    // منع الـ default Bootstrap behavior على الموبايل
    toggler.addEventListener('click', function(e) {
        if (window.innerWidth <= 991) {
            e.preventDefault();
        }
    });
});

// Smooth scrolling for anchor links
document.querySelectorAll("a[href^=\"#\"]").forEach(anchor => {
    anchor.addEventListener("click", function (e) {
        e.preventDefault();
        const target = document.querySelector(this.getAttribute("href"));
        if (target) {
            target.scrollIntoView({
                behavior: "smooth"
            });
        }
    });
});

// Add animation classes on scroll
const observerOptions = {
    threshold: 0.1,
    rootMargin: "0px 0px -50px 0px"
};

const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
        if (entry.isIntersecting) {
            entry.target.classList.add("fade-in");
        }
    });
}, observerOptions);

document.querySelectorAll(".card, .stats-card").forEach(el => {
    observer.observe(el);
});
    </script>

