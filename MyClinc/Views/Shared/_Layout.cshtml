    <meta name="keywords" content="استشارات طبية، خدمات صحية، أطباء متخصصون، عيادة طبية، صحة، طب" />
    
    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="~/images/favicon.ico">
    <link rel="apple-touch-icon" sizes="180x180" href="~/images/favicon.ico">
    
    <!-- Open Graph / Social Media -->
    <meta property="og:title" content="Doctor Hub - صحتك أولويتنا" />
    <meta property="og:description" content="منصة طبية متخصصة تقدم أفضل الاستشارات الطبية والخدمات الصحية مع فريق من الأطباء المتخصصين." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://doctorhub.com" />
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MyClinc.styles.css" asp-append-version="true" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700&display=swap" rel="stylesheet">
    <!-- Toastr CSS -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
    <!-- International Telephone Input CSS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/18.2.1/css/intlTelInput.css" />
    <link rel="stylesheet" href="~/css/intl-tel-input-custom.css" asp-append-version="true" />
    <!-- Toastr JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <link href="~/css/MedicalWhiteDesign.css" rel="stylesheet" />
    <link href="~/css/modern-notifications.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />

    <style>
        /* Enhanced Navbar Styles - نفس اللوجيك الأصلي مع تحسين الشكل */
        :root {
            --primary-color: #0d6efd;
            --primary-gradient: linear-gradient(135deg, #0d6efd, #0a58ca);
            --text-dark: #2c3e50;
            --text-medium: #6c757d;
            --border-light: #e9ecef;
            --shadow-soft: 0 4px 20px rgba(0,0,0,0.1);
            --transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        /* Enhanced Mobile Sidebar */
        @@media (max-width: 991px) {
            .navbar-collapse {
                position: fixed !important;
                top: 0 !important;
                right: -350px !important; /* زيادة العرض قليلاً */
                width: 350px !important;
                height: 100vh !important;
                height: 100dvh !important; /* للدعم الأحدث للشاشات */
                background: linear-gradient(180deg, #ffffff 0%, #f8f9fa 100%) !important;
                box-shadow: -8px 0 30px rgba(0, 0, 0, 0.15) !important;
                padding: 0 !important;
                transition: right 0.5s cubic-bezier(0.4, 0, 0.2, 1) !important;
                z-index: 99999 !important; /* زيادة الـ z-index بشكل كبير */
                display: flex !important;
                flex-direction: column !important;
                border-left: 4px solid var(--primary-color) !important;
                overflow-y: auto !important;
                overflow-x: hidden !important;
                -webkit-overflow-scrolling: touch; /* للـ smooth scrolling على الـ mobile */
                pointer-events: auto !important; /* للتأكد إن العناصر قابلة للضغط */
                visibility: hidden; /* إخفاء في البداية */
                opacity: 0; /* للـ smooth transition */
            }

            .navbar-collapse.show {
                right: 0 !important;
                visibility: visible !important;
                opacity: 1 !important;
                pointer-events: auto !important;
            }

            /* إضافة class للـ animation */
            .navbar-collapse.showing {
                visibility: visible !important;
                opacity: 1 !important;
            }

            /* إضافة header جميل للـ sidebar */
            .navbar-collapse::before {
                content: "";
                background: var(--primary-gradient);
                height: 120px;
                width: 100%;
                position: relative;
                margin-bottom: 2rem;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            /* زر الإغلاق المحسن */
            .navbar-collapse::after {
                content: "×";
                font-size: 2.5rem;
                font-weight: 300;
                position: absolute;
                top: 20px;
                left: 20px;
                cursor: pointer;
                color: white;
                width: 45px;
                height: 45px;
                border-radius: 50%;
                background: rgba(255, 255, 255, 0.2);
                display: flex;
                align-items: center;
                justify-content: center;
                transition: var(--transition);
                backdrop-filter: blur(10px);
            }

            .navbar-collapse::after:hover {
                background: rgba(255, 255, 255, 0.3);
                transform: rotate(90deg) scale(1.1);
            }

            /* تحسين شكل الروابط */
            .navbar-collapse .navbar-nav {
                padding: 0 1.5rem !important;
                gap: 0.5rem !important;
                pointer-events: auto !important;
            }

            .navbar-collapse .nav-link {
                font-size: 1.1rem !important;
                font-weight: 600 !important;
                padding: 1rem 1.2rem !important;
                border-radius: 12px !important;
                color: var(--text-dark) !important;
                border: 1px solid transparent !important;
                transition: var(--transition) !important;
                position: relative !important;
                overflow: hidden !important;
                margin-bottom: 0.3rem !important;
                display: flex !important;
                align-items: center !important;
                gap: 1rem !important;
                cursor: pointer !important;
                pointer-events: auto !important;
                user-select: none !important;
                -webkit-tap-highlight-color: transparent !important; /* لإزالة الـ highlight على الـ mobile */
            }

            /* إضافة خط جانبي عند hover */
            .navbar-collapse .nav-link::before {
                content: '';
                position: absolute;
                right: 0;
                top: 0;
                height: 100%;
                width: 4px;
                background: var(--primary-color);
                transform: scaleY(0);
                transition: transform 0.3s ease;
                border-radius: 4px 0 0 4px;
            }

            .navbar-collapse .nav-link:hover {
                color: var(--primary-color);
                background: linear-gradient(90deg, rgba(13, 110, 253, 0.08) 0%, rgba(13, 110, 253, 0.02) 100%);
                border-color: rgba(13, 110, 253, 0.2);
                transform: translateX(-8px);
                box-shadow: 0 4px 15px rgba(13, 110, 253, 0.1);
            }

            .navbar-collapse .nav-link:hover::before {
                transform: scaleY(1);
            }

            /* إضافة أيقونات للروابط */
            .navbar-collapse .nav-link[href*="Home"]::after { 
                content: '\f015'; 
                font-family: 'Font Awesome 6 Free'; 
                font-weight: 900; 
                margin-right: auto;
                opacity: 0.6;
            }
            .navbar-collapse .nav-link[href*="About"]::after { 
                content: '\f05a'; 
                font-family: 'Font Awesome 6 Free'; 
                font-weight: 900; 
                margin-right: auto;
                opacity: 0.6;
            }
            .navbar-collapse .nav-link[href*="Services"]::after { 
                content: '\f0f8'; 
                font-family: 'Font Awesome 6 Free'; 
                font-weight: 900; 
                margin-right: auto;
                opacity: 0.6;
            }
            .navbar-collapse .nav-link[href*="Courses"]::after { 
                content: '\f19d'; 
                font-family: 'Font Awesome 6 Free'; 
                font-weight: 900; 
                margin-right: auto;
                opacity: 0.6;
            }
            .navbar-collapse .nav-link[href*="DoctorJoin"]::after { 
                content: '\f0f0'; 
                font-family: 'Font Awesome 6 Free'; 
                font-weight: 900; 
                margin-right: auto;
                opacity: 0.6;
            }
            .navbar-collapse .nav-link[href*="Partnership"]::after { 
                content: '\f21b'; 
                font-family: 'Font Awesome 6 Free'; 
                font-weight: 900; 
                margin-right: auto;
                opacity: 0.6;
            }

            /* تحسين زر الاستشارة */
            .navbar-collapse .btn {
                margin: 2rem 1.5rem 1rem;
                padding: 1rem 2rem !important;
                font-size: 1.1rem;
                font-weight: 700;
                border-radius: 15px !important;
                background: var(--primary-gradient) !important;
                border: none !important;
                box-shadow: 0 6px 20px rgba(13, 110, 253, 0.3);
                transition: var(--transition);
                text-align: center;
                position: relative;
                overflow: hidden;
            }

            .navbar-collapse .btn::before {
                content: '';
                position: absolute;
                top: 0;
                left: -100%;
                width: 100%;
                height: 100%;
                background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
                transition: left 0.5s;
            }

            .navbar-collapse .btn:hover {
                transform: translateY(-3px);
                box-shadow: 0 8px 25px rgba(13, 110, 253, 0.4);
            }

            .navbar-collapse .btn:hover::before {
                left: 100%;
            }

            /* تحسين dropdown المستخدم */
            .navbar-collapse .dropdown-menu {
                background: white;
                border: none;
                border-radius: 15px;
                box-shadow: var(--shadow-soft);
                margin: 0 1.5rem;
                padding: 1rem;
            }

            .navbar-collapse .dropdown-item {
                border-radius: 8px;
                padding: 0.8rem 1rem;
                transition: var(--transition);
                font-weight: 500;
            }

            .navbar-collapse .dropdown-item:hover {
                background: rgba(13, 110, 253, 0.1);
                color: var(--primary-color);
            }

            .navbar-collapse .dropdown-item.text-danger:hover {
                background: rgba(220, 53, 69, 0.1);
                color: #dc3545;
            }

            /* تحسين معلومات المستخدم */
            .navbar-collapse .dropdown-item-text {
                background: var(--primary-gradient);
                color: white !important;
                border-radius: 10px;
                padding: 1rem !important;
                margin-bottom: 0.5rem;
                font-weight: 600;
                text-align: center;
            }

            /* Overlay محسن */
            body.offcanvas-open::before {
                content: "";
                position: fixed !important;
                top: 0 !important;
                left: 0 !important;
                width: 100vw !important;
                height: 100vh !important;
                height: 100dvh !important;
                background: linear-gradient(45deg, rgba(0,0,0,0.4), rgba(0,0,0,0.6)) !important;
                z-index: 99998 !important; /* أقل من الـ sidebar بـ 1 */
                animation: fadeIn 0.4s ease !important;
                backdrop-filter: blur(2px) !important;
                pointer-events: auto !important;
            }

            /* إضافة حماية للـ body */
            body.offcanvas-open {
                overflow: hidden !important;
                position: fixed !important;
                width: 100% !important;
            }

            /* حماية من التضارب مع elements أخرى */
            .navbar-collapse * {
                pointer-events: auto !important;
                user-select: auto !important;
                -webkit-user-select: auto !important;
            }

            @@keyframes fadeIn {
                from { 
                    opacity: 0; 
                    backdrop-filter: blur(0px);
                }
                to { 
                    opacity: 1; 
                    backdrop-filter: blur(2px);
                }
            }
        }

        /* تحسين الـ navbar العام */
        .navbar {
            background: rgba(255, 255, 255, 0.98) !important;
            backdrop-filter: blur(10px) !important;
            box-shadow: 0 2px 20px rgba(0,0,0,0.08) !important;
            transition: var(--transition) !important;
            z-index: 1050 !important; /* أقل من الـ sidebar */
        }

        .navbar-brand {
            font-weight: 700 !important;
            color: var(--primary-color) !important;
            transition: var(--transition) !important;
        }

        .navbar-brand:hover {
            color: #0a58ca !important;
            transform: scale(1.02) !important;
        }

        /* تحسين زر الهامبورجر */
        .navbar-toggler {
            border: none !important;
            padding: 0.5rem !important;
            background: var(--primary-gradient) !important;
            border-radius: 10px !important;
            width: 50px !important;
            height: 45px !important;
            position: relative !important;
            transition: var(--transition) !important;
            z-index: 99999 !important; /* نفس الـ sidebar */
        }

        .navbar-toggler:focus {
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25) !important;
        }

        .navbar-toggler:hover {
            transform: scale(1.05) !important;
            box-shadow: 0 4px 15px rgba(13, 110, 253, 0.3) !important;
        }

        /* إضافة حماية عامة */
        * {
            box-sizing: border-box;
        }

        html, body {
            overflow-x: hidden;
        }

        /* حماية من تضارب الـ modals أو overlays أخرى */
        .modal, .offcanvas, .dropdown-menu {
            z-index: 99997 !important;
        }

        .tooltip, .popover {
            z-index: 100000 !important;
        }

        .navbar-toggler-icon {
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='rgba%28255, 255, 255, 1%29' stroke-linecap='round' stroke-miterlimit='10' stroke-width='2' d='m4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e");
        }

        /* تحسين الروابط في الـ desktop */
        @@media (min-width: 992px) {
            .nav-link {
                color: var(--text-dark);
                font-weight: 500;
                padding: 0.5rem 1rem !important;
                border-radius: 8px;
                transition: var(--transition);
                position: relative;
            }

            .nav-link::after {
                content: '';
                position: absolute;
                bottom: 0;
                right: 50%;
                width: 0;
                height: 2px;
                background: var(--primary-color);
                transition: all 0.3s ease;
            }

            .nav-link:hover {
                color: var(--primary-color);
                background: rgba(13, 110, 253, 0.08);
            }

            .nav-link:hover::after {
                width: 80%;
                right: 10%;
            }

            .btn-primary {
                background: var(--primary-gradient);
                border: none;
                padding: 0.6rem 1.5rem;
                border-radius: 25px;
                font-weight: 600;
                transition: var(--transition);
                box-shadow: 0 4px 15px rgba(13, 110, 253, 0.3);
            }

            .btn-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(13, 110, 253, 0.4);
            }
        }
    </style>

</head>
<body>
