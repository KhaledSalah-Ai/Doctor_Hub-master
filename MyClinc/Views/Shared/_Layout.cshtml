    <script>
document.addEventListener("DOMContentLoaded", function () {
    const collapse = document.querySelector(".navbar-collapse");
    const toggler = document.querySelector(".navbar-toggler");
    const body = document.body;

    // التأكد من إن الـ sidebar مخفي في البداية
    collapse.style.visibility = 'hidden';
    collapse.style.opacity = '0';

    // فتح وقفل الـ Sidebar
    toggler.addEventListener("click", function (e) {
        e.preventDefault();
        e.stopPropagation();
        
        // إضافة delay صغير للتأكد من الـ visibility
        setTimeout(() => {
            body.classList.toggle("offcanvas-open");
            
            if (body.classList.contains("offcanvas-open")) {
                collapse.style.visibility = 'visible';
                collapse.style.opacity = '1';
                collapse.classList.add("showing");
            } else {
                collapse.style.visibility = 'hidden';
                collapse.style.opacity = '0';
                collapse.classList.remove("showing");
            }
        }, 10);
    });

    // قفل لما يضغط على علامة × مع حماية أفضل
    collapse.addEventListener("click", function (e) {
        e.stopPropagation();
        const clickedElement = e.target;
        
        // التحقق من الـ close button بطرق متعددة
        if (clickedElement.textContent === "×" || 
            clickedElement.classList.contains('close-btn') ||
            clickedElement.closest('.close-btn') ||
            getComputedStyle(clickedElement, '::after').content === '"×"') {
            
            closeSidebar();
        }
    });

    // قفل لما يضغط على الـ Overlay
    document.addEventListener("click", function (e) {
        if (body.classList.contains("offcanvas-open")) {
            // التأكد إن الضغطة مش جوا الـ sidebar أو الـ toggler
            if (!collapse.contains(e.target) && !toggler.contains(e.target)) {
                closeSidebar();
            }
        }
    });

    // قفل بالـ escape key
    document.addEventListener("keydown", function(e) {
        if (e.key === "Escape" && body.classList.contains("offcanvas-open")) {
            closeSidebar();
        }
    });

    // دالة إغلاق الـ sidebar
    function closeSidebar() {
        collapse.classList.remove("show");
        collapse.classList.remove("showing");
        body.classList.remove("offcanvas-open");
        
        // إخفاء الـ sidebar بعد الانتهاء من الـ animation
        setTimeout(() => {
            if (!body.classList.contains("offcanvas-open")) {
                collapse.style.visibility = 'hidden';
                collapse.style.opacity = '0';
            }
        }, 500);
    }

    // حماية من الـ touch events على الـ mobile
    let touchStartX = null;
    
    collapse.addEventListener('touchstart', function(e) {
        touchStartX = e.touches[0].clientX;
    });

    collapse.addEventListener('touchmove', function(e) {
        if (touchStartX === null) return;
        
        let touchCurrentX = e.touches[0].clientX;
        let diff = touchCurrentX - touchStartX;
        
        // إذا السحب لليسار أكتر من 50px، قفل الـ sidebar
        if (diff < -50) {
            closeSidebar();
            touchStartX = null;
        }
    });

    collapse.addEventListener('touchend', function() {
        touchStartX = null;
    });

    // التأكد من إن الـ sidebar يشتغل مع Bootstrap
    const bsCollapse = new bootstrap.Collapse(collapse, {
        toggle: false
    });
    
    toggler.addEventListener('click', function() {
        if (body.classList.contains("offcanvas-open")) {
            bsCollapse.show();
        } else {
            bsCollapse.hide();
        }
