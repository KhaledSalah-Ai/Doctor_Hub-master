@{
    ViewData["Title"] = "حجز استشارة طبية";
}

<link href="~/css/HomeIndex.css" rel="stylesheet" />



<section class="section-padding bg-light">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="question-card">
                    <div class="question-icon">
                        <i class="fas fa-question-circle"></i>
                    </div>
                    
                    <h3 class="question-title">هل سبق وأن حجزت استشارة معنا من قبل؟</h3>
                    
                    @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
                    {
                        <div class="alert alert-danger" role="alert">
                            @ViewBag.ErrorMessage
                        </div>
                    }
                    
                    <form method="post" asp-action="BookingQuestion">
                        <div class="answer-buttons">
                            <button type="submit" name="answer" value="yes" class="answer-btn yes-btn">
                                <i class="fas fa-check-circle"></i>
                                نعم، حجزت من قبل
                            </button>
                            
                            <button type="submit" name="answer" value="no" class="answer-btn no-btn">
                                <i class="fas fa-user-plus"></i>
                                لا، هذه أول مرة
                            </button>
                        </div>
                    </form>
                    
                    <div class="help-text">
                        <p>إذا كنت حجزت معنا من قبل، سنحتاج فقط لرقم هاتفك لاسترداد بياناتك</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .min-vh-50 {
        min-height: 50vh;
    }
    
    .question-card {
        background: white;
        border-radius: 20px;
        padding: 3rem;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        text-align: center;
        position: relative;
        overflow: hidden;
    }
    
    .question-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 5px;
        background: linear-gradient(90deg, #2c5aa0, #17a2b8);
    }
    
    .question-icon {
        font-size: 4rem;
        color: #2c5aa0;
        margin-bottom: 2rem;
        animation: pulse 2s infinite;
    }
    
    @@keyframes pulse {
        0% { transform: scale(1); }
        50% { transform: scale(1.1); }
        100% { transform: scale(1); }
    }
    
    .question-title {
        color: #333;
        margin-bottom: 2rem;
        font-weight: 700;
        font-size: 1.5rem;
        line-height: 1.4;
    }
    
    .answer-buttons {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-bottom: 2rem;
    }
    
    .answer-btn {
        padding: 1rem 2rem;
        border: none;
        border-radius: 15px;
        font-size: 1.1rem;
        font-weight: 600;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }
    
    .yes-btn {
        background: linear-gradient(135deg, #28a745, #20c997);
        color: white;
        border: 2px solid transparent;
    }
    
    .yes-btn:hover {
        background: linear-gradient(135deg, #20c997, #28a745);
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(40, 167, 69, 0.3);
    }
    
    .no-btn {
        background: linear-gradient(135deg, #2c5aa0, #17a2b8);
        color: white;
        border: 2px solid transparent;
    }
    
    .no-btn:hover {
        background: linear-gradient(135deg, #17a2b8, #2c5aa0);
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(44, 90, 160, 0.3);
    }
    
    .help-text {
        background: #f8f9fa;
        padding: 1rem;
        border-radius: 10px;
        border-left: 4px solid #17a2b8;
    }
    
    .help-text p {
        margin: 0;
        color: #6c757d;
        font-size: 0.9rem;
        line-height: 1.5;
    }
    
    @@media (max-width: 768px) {
        .question-card {
            padding: 2rem;
            margin: 1rem;
        }
        
        .question-title {
            font-size: 1.3rem;
        }
        
        .question-icon {
            font-size: 3rem;
        }
    }
    
    /* Animation for card entrance */
    .question-card {
        animation: slideInUp 0.8s ease-out;
    }
    
    @@keyframes slideInUp {
        from {
            opacity: 0;
            transform: translateY(50px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>