@{
    ViewBag.Title = "التأكد من الحجز السابق";
}

<div class="d-flex justify-content-center align-items-center vh-100">
    <div class="card shadow-lg p-4" style="max-width: 500px; width:100%; border-radius: 15px;">
        <h4 class="text-center mb-4">هل حجزت استشارة قبل كده؟</h4>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                @TempData["Error"]
            </div>
        }

        <form asp-action="CheckBooking" method="post">
            <div class="form-check mb-2">
                <input class="form-check-input" type="radio" name="hasBooked" id="hasBookedNo" value="No" checked onclick="togglePhoneInput(false)" />
                <label class="form-check-label" for="hasBookedNo">لا</label>
            </div>

            <div class="form-check mb-2">
                <input class="form-check-input" type="radio" name="hasBooked" id="hasBookedYes" value="Yes" onclick="togglePhoneInput(true)" />
                <label class="form-check-label" for="hasBookedYes">نعم</label>
            </div>

            <div id="phoneInputContainer" style="display:none;" class="mt-3">
                <label for="phoneNumber" class="form-label">أدخل رقم الهاتف الدولي:</label>
                <input type="text" class="form-control" id="phoneNumber" name="phoneNumber" placeholder="+201234567890" />
            </div>

            <button type="submit" class="btn btn-primary w-100 mt-4">متابعة</button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function togglePhoneInput(show) {
            document.getElementById("phoneInputContainer").style.display = show ? "block" : "none";
        }
    </script>
}
<style>
    .card {
        display: block !important;
        opacity: 1 !important;
        visibility: visible !important;
    }
</style>