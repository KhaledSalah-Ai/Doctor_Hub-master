@model DAL.Data.Models.Consultation
@{
    ViewData["Title"] = "حجز استشارة";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.19/css/intlTelInput.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.19/js/intlTelInput.min.js"></script>

<div class="container my-5">
    <!-- العنوان -->
    <div class="text-center mb-5">
        <h2 class="fw-bold text-success">حجز استشارة طبية</h2>
        <p class="text-muted">يرجى تعبئة البيانات التالية بدقة لتأكيد حجزك</p>
    </div>

    <!-- الكارت الرئيسي -->
    <div class="main-card shadow-lg border-0 rounded-4 p-4">
        <form asp-action="Book" asp-controller="Consultation" method="post">
            <div class="row g-4">

                <!-- الاسم -->
                <div class="col-md-6 info-card">
                    <label asp-for="PatientName" class="form-label fw-bold"></label>
                    <input asp-for="PatientName" class="form-control rounded-3" required />
                    <span asp-validation-for="PatientName" class="text-danger small"></span>
                </div>

                <!-- الهاتف -->
                <div class="col-md-6 info-card">
                    <label class="form-label fw-bold">رقم الهاتف</label>
                    <input id="phoneInput" type="tel" class="form-control rounded-3" />
                    <input type="hidden" asp-for="PhoneNumber" />
                    <input type="hidden" asp-for="FullPhoneNumber" />
                    <span asp-validation-for="FullPhoneNumber" class="text-danger small"></span>
                </div>

                <!-- تاريخ الميلاد -->
                <div class="col-md-6 info-card">
                    <label asp-for="BirthDate" class="form-label fw-bold"></label>
                    <input asp-for="BirthDate" type="date" class="form-control rounded-3" required />
                    <span asp-validation-for="BirthDate" class="text-danger small"></span>
                </div>

                <!-- هل عراقي -->
                <div class="col-md-6 info-card">
                    <label class="form-label fw-bold">هل أنت عراقي؟</label>
                    <div class="d-flex gap-4 mt-2">
                        <div class="form-check">
                            <input asp-for="IsIraqi" class="form-check-input" type="radio" value="true" id="isIraqiYes" />
                            <label for="isIraqiYes" class="form-check-label">نعم</label>
                        </div>
                        <div class="form-check">
                            <input asp-for="IsIraqi" class="form-check-input" type="radio" value="false" id="isIraqiNo" />
                            <label for="isIraqiNo" class="form-check-label">لا</label>
                        </div>
                    </div>
                    <span asp-validation-for="IsIraqi" class="text-danger small"></span>
                </div>

                <!-- بلد الميلاد -->
                <div class="col-md-6 info-card" id="birthCountryDiv">
                    <label asp-for="BirthCountry" class="form-label fw-bold"></label>
                    <input asp-for="BirthCountry" class="form-control rounded-3" />
                    <span asp-validation-for="BirthCountry" class="text-danger small"></span>
                </div>

                <!-- بلد السكن -->
                <div class="col-md-6 info-card">
                    <label asp-for="CurrentCountry" class="form-label fw-bold"></label>
                    <input asp-for="CurrentCountry" class="form-control rounded-3" required />
                    <span asp-validation-for="CurrentCountry" class="text-danger small"></span>
                </div>

                <!-- العمل / الدراسة -->
                <div class="col-md-6 info-card">
                    <label asp-for="WorkOrStudyPlace" class="form-label fw-bold"></label>
                    <input asp-for="WorkOrStudyPlace" class="form-control rounded-3" />
                </div>

                <!-- الجنس -->
                <div class="col-md-6 info-card">
                    <label asp-for="Gender" class="form-label fw-bold"></label>
                    <select asp-for="Gender" class="form-select rounded-3">
                        <option value="">-- اختر --</option>
                        <option value="ذكر">ذكر</option>
                        <option value="أنثى">أنثى</option>
                    </select>
                </div>

                <!-- الحالة الاجتماعية -->
                <div class="col-md-6 info-card">
                    <label asp-for="MaritalStatus" class="form-label fw-bold"></label>
                    <select asp-for="MaritalStatus" class="form-select rounded-3">
                        <option value="">-- اختر --</option>
                        <option value="أعزب">أعزب</option>
                        <option value="متزوج">متزوج</option>
                        <option value="أرمل">أرمل</option>
                        <option value="مطلق">مطلق</option>
                    </select>
                </div>

                <div class="col-md-6 info-card">
                    <label asp-for="MedicalSymptoms" class="form-label fw-bold"></label>
                    <input asp-for="MedicalSymptoms" class="form-control rounded-3" required />
                    <span asp-validation-for="MedicalSymptoms" class="text-danger small"></span>
                </div>

                <!-- التخصص -->
                <div class="col-md-6 info-card">
                    <label asp-for="MedicalSpecialtyId" class="form-label fw-bold"></label>
                    <select asp-for="MedicalSpecialtyId" class="form-select rounded-3" required
                            asp-items="@(new SelectList(ViewBag.MedicalSpecialties, "Id", "Name"))"
                            id="MedicalSpecialtyId">
                        <option value="">-- اختر التخصص --</option>
                    </select>
                    <span asp-validation-for="MedicalSpecialtyId" class="text-danger small"></span>
                </div>

                <!-- المواعيد -->
                <div class="col-md-6 info-card" id="availabilityDiv" style="display:none;">
                    <label asp-for="AdvisorAvailabilityId" class="form-label fw-bold">اختر الميعاد</label>
                    <select asp-for="AdvisorAvailabilityId" class="form-select rounded-3" id="AdvisorAvailabilityId"></select>
                    <span asp-validation-for="AdvisorAvailabilityId" class="text-danger small"></span>
                </div>

                <!-- رسوم الاستشارة -->
                <div class="col-12 consultation-fee-display mt-3" style="display:none;">
                    <label class="form-label fw-bold">رسوم الاستشارة:</label>
                    <div id="feeAmount" class="alert alert-info fw-bold mb-0"></div>
                </div>

                <!-- زر -->
                <div class="col-12 text-center mt-4">
                    <button type="submit" class="btn btn-success px-5 py-2 rounded-3 fw-bold shadow-sm">
                        <i class="bi bi-check-circle"></i> اختر الميعاد
                    </button>
                </div>

            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const input = document.querySelector("#phoneInput");
        const iti = window.intlTelInput(input, {
            initialCountry: "auto",
            geoIpLookup: function (callback) {
                fetch("https://ipapi.co/json")
                    .then(res => res.json())
                    .then(data => callback(data.country_code))
                    .catch(() => callback("us"));
            },
            utilsScript: "https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.19/js/utils.js"
        });

        document.querySelector("form").addEventListener("submit", function () {
            let number = iti.getNumber(intlTelInputUtils.numberFormat.E164);
            let national = iti.getNumber(intlTelInputUtils.numberFormat.NATIONAL);
            document.querySelector("input[name='PhoneNumber']").value = national.replace(/\s+/g, '');
            document.querySelector("input[name='FullPhoneNumber']").value = number.replace(/\s+/g, '');
        });

        // إظهار/إخفاء بلد الميلاد بناءً على هل عراقي؟
        document.querySelectorAll('input[name="IsIraqi"]').forEach(r => {
            r.addEventListener('change', function () {
                const birthDiv = document.getElementById('birthCountryDiv');
                const input = document.getElementById('BirthCountry');
                if (this.value === "true") {
                    birthDiv.style.display = "none";
                    input.value = "العراق";
                } else {
                    birthDiv.style.display = "block";
                    input.value = "";
                }
            });
        });

        // جلب المواعيد الخاصة بالتخصص
        document.getElementById('MedicalSpecialtyId').addEventListener('change', function () {
            const specialtyId = this.value;
            const availabilityDiv = document.getElementById('availabilityDiv');
            const availabilitySelect = document.getElementById('AdvisorAvailabilityId');

            if (!specialtyId) {
                availabilityDiv.style.display = 'none';
                return;
            }

            fetch(`/Consultation/GetAvailability?specialtyId=${specialtyId}`)
                .then(res => res.json())
                .then(data => {
                    availabilitySelect.innerHTML = "";
                    if (data.length > 0) {
                        data.forEach(slot => {
                            const opt = document.createElement("option");
                            opt.value = slot.id;
                            opt.textContent = slot.display;
                            availabilitySelect.appendChild(opt);
                        });
                        availabilityDiv.style.display = "block";
                    } else {
                        availabilityDiv.style.display = "none";
                    }
                });
        });
    </script>
}

<style>
    .main-card {
        background: #fff;
        border-radius: 20px;
        padding: 30px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    }

    .info-card {
        background: #f9f9f9;
        border-radius: 15px;
        padding: 15px;
        box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.05);
    }

    .form-label {
        color: #2c3e50;
    }

    h2, h5 {
        color: #16a34a;
    }

    button.btn-success {
        background: linear-gradient(45deg, #16a34a, #4ade80);
        border: none;
        transition: 0.3s;
    }

        button.btn-success:hover {
            background: linear-gradient(45deg, #15803d, #22c55e);
            transform: scale(1.05);
        }
</style>
