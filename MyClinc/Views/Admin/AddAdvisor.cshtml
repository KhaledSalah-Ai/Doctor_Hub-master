@model MyClinc.ViewModels.AdvisorViewModel

@{
    ViewData["Title"] = "إضافة دكتور جديد";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8 col-sm-10">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-gradient bg-primary text-white text-center py-3 rounded-top-4">
                    <h4 class="mb-0 fw-bold">@ViewData["Title"]</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="AddAdvisor" method="post">
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label small fw-semibold text-muted"></label>
                            <input asp-for="Name" class="form-control rounded-3" placeholder="ادخل اسم الدكتور" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label small fw-semibold text-muted"></label>
                            <input asp-for="Email" class="form-control rounded-3" placeholder="ادخل البريد الإلكتروني" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label small fw-semibold text-muted"></label>
                            <div class="input-group">
                                <input asp-for="Password" type="password" class="form-control rounded-start-3" placeholder="ادخل كلمة المرور" id="passwordInput" />
                                <button type="button" class="btn btn-outline-secondary rounded-end-3" id="togglePassword">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Phone" class="form-label small fw-semibold text-muted"></label>
                            <input asp-for="Phone" class="form-control rounded-3" placeholder="ادخل رقم الهاتف" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MedicalSpecialtyId" class="form-label small fw-semibold text-muted"></label>
                            <select asp-for="MedicalSpecialtyId" class="form-select rounded-3"
                                    asp-items="@(new SelectList(Model.AvailableSpecialties, "Id", "Name"))">
                                <option value="">-- اختر التخصص --</option>
                            </select>
                            <span asp-validation-for="MedicalSpecialtyId" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary fw-bold shadow-sm rounded-3">
                                <i class="bi bi-save"></i> حفظ
                            </button>
                            <a asp-action="Advisors" class="btn btn-outline-secondary rounded-3">
                                <i class="bi bi-x-circle"></i> إلغاء
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const passwordInput = document.getElementById("passwordInput");
        const togglePassword = document.getElementById("togglePassword");

        togglePassword.addEventListener("click", function () {
            const type = passwordInput.getAttribute("type") === "password" ? "text" : "password";
            passwordInput.setAttribute("type", type);

            this.innerHTML = type === "password"
                ? '<i class="bi bi-eye"></i>'
                : '<i class="bi bi-eye-slash"></i>';
        });
    </script>
}

<style>
    .card {
        border-radius: 1rem !important;
    }

    .form-control:focus, .form-select:focus {
        box-shadow: 0 0 0 .2rem rgba(13,110,253,.25);
    }

    .btn-primary:hover {
        background-color: #0b5ed7;
    }
</style>









