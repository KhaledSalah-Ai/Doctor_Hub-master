@model DAL.Data.Models.CoursePurchaseRequest
@{
    ViewData["Title"] = "Edit Purchase";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

}

<style>
    .center-page {
        min-height: 80vh;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .form-box {
        background-color: #fff;
        padding: 30px;
        border-radius: 10px;
        box-shadow: 0 0 15px rgba(0, 0, 0, 0.1);
        width: 100%;
        max-width: 600px;
    }

    h1 {
        text-align: center;
        margin-bottom: 20px;
    }
</style>

<div class="container center-page">
    <div class="form-box">
        <h1>تعديل عملية الشراء</h1>

        <form asp-action="EditPurchase">
            <div class="form-group mb-3">
                <label asp-for="User.Email"></label>
                <input asp-for="User.Email" class="form-control" value="@Model.User.Email" readonly />
            </div>

            <div class="form-group mb-3">
                <label asp-for="Course.Title"></label>
                <input asp-for="Course.Title" class="form-control" readonly />
            </div>

            <div class="form-group mb-3">
                <label asp-for="IsApproved">هل تم الموافقة؟</label><br />
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" asp-for="IsApproved" value="true" id="approvedTrue">
                    <label class="form-check-label" for="approvedTrue">نعم</label>
                </div>

                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" asp-for="IsApproved" value="false" id="approvedFalse">
                    <label class="form-check-label" for="approvedFalse">لا</label>
                </div>
                <span asp-validation-for="IsApproved" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="paymentStatuse">حالة الدفع</label>
                <select asp-for="paymentStatuse" asp-items="ViewBag.PaymentStatusList" class="form-control"></select>
            </div>

            <button type="submit" class="btn btn-success w-100">حفظ التعديلات</button>
            <div class="d-grid mt-4">

                <a asp-action="Purchases" class="btn btn-sm btn-outline-dark">Back To List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
