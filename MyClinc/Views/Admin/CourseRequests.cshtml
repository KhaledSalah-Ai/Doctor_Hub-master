@model List<DAL.Data.Models.CoursePurchaseRequest>

@{
    ViewBag.Title = "Course Purchase Requests";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

}

<div class="container mt-4">
    <h2 class="mb-4">Course Purchase Requests</h2>

    <table class="table table-bordered table-hover table-striped">
        <thead class="thead-dark">
            <tr>
                <th>User</th>
                <th>Course</th>
                <th>Status</th>
                <th>Created At</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var request in Model)
                {
                    <tr>
                        <td>@request.User?.UserName</td>
                        <td>@request.Course?.Title</td>
                        <td>
                            @if (request.paymentStatuse == DAL.Data.Models.PaymentStatuse.Approved)
                            {
                                <span class="badge bg-success">Approved</span>
                            }
                            else if (request.paymentStatuse == DAL.Data.Models.PaymentStatuse.Rejected)
                            {
                                <span class="badge bg-danger">Rejected</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Pending</span>
                            }
                        </td>
                        <td>@request.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            @if (request.paymentStatuse == DAL.Data.Models.PaymentStatuse.Pending)
                            {
                                <form asp-action="ApproveCourseRequest" method="post" class="d-inline">
                                    <input type="hidden" name="requestId" value="@request.Id" />
                                    <button type="submit" class="btn btn-success btn-sm">Approve</button>
                                </form>
                                <form asp-action="RejectCourseRequest" method="post" class="d-inline ms-1">
                                    <input type="hidden" name="requestId" value="@request.Id" />
                                    <button type="submit" class="btn btn-danger btn-sm">Reject</button>
                                </form>
                            }
                            else
                            {
                                <span class="text-muted">No actions</span>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center text-muted">No purchase requests found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
