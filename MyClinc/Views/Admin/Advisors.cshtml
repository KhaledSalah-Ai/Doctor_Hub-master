@model List<DAL.Data.Models.Advisor>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold">Advisors Management</h2>
        <a href="/Admin/AddAdvisor" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Add Advisor
        </a>
    </div>

    <table class="table table-striped table-bordered shadow-sm">
        <thead class="table-dark text-center">
            <tr>
                <th scope="col">#</th>
                <th scope="col">Advisor Name</th>
                <th scope="col">Email</th>
                <th scope="col">Phone</th>
                <th scope="col">Medical Specialty</th>
                <th scope="col" style="width: 180px;">Actions</th>
            </tr>
        </thead>
        <tbody class="align-middle text-center">
            @if (Model != null && Model.Any())
            {
                var index = 1;
                foreach (var item in Model)
                {
                    <tr>
                        <td>@index</td>
                        <td>@item.Name</td>
                        <td>@item.Email</td>
                        <td>@item.Phone</td>
                        <td>@item.MedicalSpecialty?.Name</td>
                        <td>
                            <div class="d-flex justify-content-center gap-2">
                                <a href="/Admin/EditAdvisor/@item.AdvisorId" class="btn btn-sm btn-warning">
                                    <i class="bi bi-pencil-square"></i> Edit
                                </a>
                                <a href="/Admin/DeleteAdvisor/@item.AdvisorId" class="btn btn-sm btn-danger"
                                   onclick="return confirm('Are you sure you want to delete this advisor?');">
                                    <i class="bi bi-trash"></i> Delete
                                </a>
                            </div>
                        </td>
                    </tr>
                    index++;
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center text-muted">No advisors found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
