@model MyClinc.ViewModels.ConsultationPaginationViewModel

@{
    ViewData["Title"] = "استشاراتي";
    Layout = "~/Views/Shared/_AdvisorLayout.cshtml";
}

<div class="container mt-5">
    <div class="card shadow-lg rounded-3 border-0">
        <div class="card-header bg-primary text-white text-center fs-4 fw-bold py-3">
            كل الاستشارات الخاصة بي
        </div>
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-center">
                    <tr>
                        <th>👤 اسم المريض</th>
                        <th>📞 رقم الهاتف</th>
                        <th>📅 تاريخ الحجز</th>
                        <th>⏰ الموعد</th>
                        <th>⚡ الحالة</th>
                        <th>⚙️ الإجراءات</th>
                    </tr>
                </thead>
                <tbody class="text-center">
                    @foreach (var c in Model.Consultations)
                    {
                        <tr>
                            <td class="fw-semibold">@c.PatientName</td>
                            <td>@c.FullPhoneNumber</td>
                            <td>@c.AdvisorAvailability.Date.ToString("dd/MM/yyyy")</td>
                            <td>@c.AdvisorAvailability.StartTime</td>
                            <td>
                                <span class="badge px-3 py-2 fs-6 @(c.Status == "Completed" ? "bg-success" : "bg-warning text-dark")">
                                    @c.Status
                                </span>
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@c.ConsultationId"
                                   class="btn btn-outline-info btn-sm me-1">
                                    <i class="bi bi-info-circle"></i> تفاصيل
                                </a>

                                @if (c.Status != "Completed")
                                {
                                    <button type="button" class="btn btn-outline-danger btn-sm"
                                            data-bs-toggle="modal"
                                            data-bs-target="#deleteModal"
                                            data-id="@c.ConsultationId">
                                        <i class="bi bi-trash"></i> حذف
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <div class="card-footer bg-light">
            <nav aria-label="Page navigation">
                <ul class="pagination justify-content-center mb-0">
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="MyConsultations" asp-route-page="@(Model.CurrentPage - 1)">
                            السابق
                        </a>
                    </li>

                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                            <a class="page-link" asp-action="MyConsultations" asp-route-page="@i">@i</a>
                        </li>
                    }

                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="MyConsultations" asp-route-page="@(Model.CurrentPage + 1)">
                            التالي
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
</div>


<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg rounded-3">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="bi bi-exclamation-triangle"></i> تأكيد الحذف</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="إغلاق"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0 fs-6">هل أنت متأكد أنك تريد حذف هذه الاستشارة؟</p>
            </div>
            <div class="modal-footer">
                <form id="deleteForm" method="post" asp-action="Delete" asp-controller="Advisor">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="consultationId" />
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-danger">نعم، حذف</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const deleteModal = document.getElementById('deleteModal');
        const consultationIdInput = document.getElementById('consultationId');

        deleteModal.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            const consultationId = button.getAttribute('data-id');
            consultationIdInput.value = consultationId;
        });
    </script>
}
