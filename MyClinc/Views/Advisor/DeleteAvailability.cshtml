@model DAL.Data.Models.AdvisorAvailability
@{
    ViewData["Title"] = "حذف موعد";
    Layout = "~/Views/Shared/_AdvisorLayout.cshtml";
}

<h2 class="text-danger mb-4">هل أنت متأكد من حذف هذا الموعد؟</h2>

<div class="card p-3">
    <p><strong>التاريخ:</strong> @Model.Date.ToString("dd-MM-yyyy")</p>
    <p><strong>وقت البدء:</strong> @Model.StartTime.ToString(@"hh\:mm")</p>
    <p><strong>المدة:</strong> @Model.DurationMinutes دقيقة</p>
    <p><strong>الحالة:</strong> @(Model.IsBooked ? "محجوز" : "متاح")</p>
</div>

<form asp-action="DeleteAvailabilityConfirmed" method="post" class="mt-3">
    @Html.AntiForgeryToken()
    <input type="hidden" name="availabilityId" value="@Model.AvailabilityId" />

    <button type="submit" class="btn btn-danger">
        <i class="fas fa-trash"></i> تأكيد الحذف
    </button>
    <a asp-action="Dashboard" class="btn btn-secondary">إلغاء</a>
</form>

